# Beelink variant of agent-computer: the upstream image plus a VNC path into the Bot's Chromium, so a
# person can sign in to sites from any device (phone, tablet) with a real keyboard and mouse.
FROM mcr.microsoft.com/playwright:v1.62.1-noble
RUN apt-get update && apt-get install -y --no-install-recommends unzip x11vnc novnc websockify poppler-utils python3-pip && rm -rf /var/lib/apt/lists/*
# PDF reading for the analysts (research downloads bank reports). Baked into the image because
# anything a Bot pip-installs at runtime lives in the container layer and is lost on recreate.
RUN pip3 install --no-cache-dir --break-system-packages pypdf pdfplumber pandas numpy statsmodels matplotlib
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"
WORKDIR /app
COPY agent-computer/package.json agent-computer/bun.lock ./
RUN bun install --frozen-lockfile
COPY agent-computer/src ./src
RUN mkdir -p /workspace
# Analyst helper scripts (tenant-specific), available in every computer regardless of workspace state.
COPY examples/beelink/computer-scripts /opt/scripts
RUN chmod +x /opt/scripts/*.py
ENV WORKSPACE_DIR=/workspace
ENV PORT=4100
EXPOSE 4100
HEALTHCHECK --interval=2s --timeout=3s --start-period=2s --retries=30 \
  CMD bun -e "const r = await fetch('http://localhost:4100/health'); process.exit(r.ok ? 0 : 1)"
CMD ["bun", "src/index.ts"]
