[Unit]
Description=Ownbot read-only FX SSH endpoint (Tailnet only)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sshd_config_ownbot_fx
ExecStart=/usr/sbin/sshd -D -e -f /etc/ssh/sshd_config_ownbot_fx
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
